<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <!-- Compilação em segundo plano + notificações -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <application>
    <!-- Subclasse própria pra não brigar com o FileProvider do expo-file-system -->
    <provider
      android:name="expo.modules.apkbuilder.ApkBuilderFileProvider"
      android:authorities="${applicationId}.apkbuilder.fileprovider"
      android:exported="false"
      android:grantUriPermissions="true">
      <meta-data
        android:name="android.support.FILE_PROVIDER_PATHS"
        android:resource="@xml/apk_builder_paths" />
    </provider>

    <!-- Mantém a compilação viva fora da tela -->
    <service
      android:name="expo.modules.apkbuilder.CompilacaoService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
  </application>

</manifest>
