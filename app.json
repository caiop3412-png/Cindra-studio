{
  "expo": {
    "name": "Cindra Studio",
    "slug": "cindra-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "com.cindratech.studio",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0c0d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.MANAGE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.** { *; }\n-keepclassmembers class expo.modules.** { *; }\n-keep class org.unimodules.** { *; }\n-keep class com.cindraai.** { *; }\n-keepclassmembers class com.cindraai.** { *; }\n-keep class com.cindratech.** { *; }\n-keepclassmembers class com.cindratech.** { *; }\n-keep class org.eclipse.jdt.** { *; }\n-keep class com.android.tools.r8.** { *; }\n-keep class com.android.apksig.** { *; }\n-dontwarn org.eclipse.jdt.**\n-dontwarn com.android.tools.r8.**\n-dontwarn com.android.apksig.**\n-dontwarn javax.tools.**\n-dontwarn javax.lang.model.**\n-dontwarn java.lang.module.**",
            "useLegacyPackaging": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ff5227",
          "defaultChannel": "lembretes"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c0c0d"
        }
      ],
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "6724e75f-bb9e-4355-9d88-94547db46ec3"
      }
    },
    "owner": "jhonye",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6724e75f-bb9e-4355-9d88-94547db46ec3"
    },
    "ios": {}
  }
}
