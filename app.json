{
  "expo": {
    "name": "Cindra Studio",
    "slug": "cindra-studio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c0c0d"
    },
    "android": {
      "package": "com.cindratech.studio",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c0c0d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "useLegacyPackaging": true,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6724e75f-bb9e-4355-9d88-94547db46ec3"
      }
    },
    "owner": "jhonye"
  }
}
